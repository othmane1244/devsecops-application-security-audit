              "shortDescription": {
                "markdown": "CVE-2026-71538: @cyclonedx/cyclonedx-npm: Shell Injection via Unsanitized --workspace Argument on Windows",
                "text": "CVE-2026-71538: @cyclonedx/cyclonedx-npm: Shell Injection via Unsanitized --workspace Argument on Windows"
